<%= turbo_frame_tag @card, :release_picker do %>
  <div class="flex-column full-width"
      data-controller="filter navigable-list"
      data-filter-limit-value="<%= Card::Releasable::SHOWN_BY_DEFAULT %>"
      data-navigable-list-focus-on-selection-value="false"
      data-navigable-list-actionable-items-value="true"
      data-action="keydown->navigable-list#navigate filter:changed->navigable-list#reset dialog:show@document->navigable-list#reset">
    <strong class="popup__title">Released in…</strong>

    <%= form_with model: @card, url: card_release_path(@card), method: :patch,
          id: dom_id(@card, :release_form),
          data: { controller: "form", action: "submit->form#preventEmptySubmit" },
          class: "flex flex-column gap-half full-width margin-block-half" do |form| %>
      <%= form.text_field :release, value: nil,
            placeholder: @releases.any? ? "Add a new release or filter…" : "Name this release…",
            class: "input txt-small full-width", autocomplete: "off", autofocus: true,
            data: { filter_target: "input", form_target: "input", action: "input->filter#filter" } %>
    <% end %>

    <ul class="popup__list" data-filter-target="list">
      <% @releases.each do |release| %>
        <% released_in = @card.released_in?(release) %>
        <%= tag.li class: "popup__item", role: "checkbox", aria: { checked: released_in },
              data: { filter_target: "item", navigable_list_target: "item" } do %>
          <%# Re-picking the release a card is already in clears it, the way re-picking a tag untags it. %>
          <%= button_to card_release_path(@card),
                method: released_in ? :delete : :patch,
                params: released_in ? {} : { card: { release: release } },
                class: "popup__btn btn", form_class: "max-width flex-item-grow" do %>
            <span class="overflow-ellipsis flex-item-grow"><%= release %></span>
            <span class="for-screen-reader"><%= released_in ? "Clear this release" : "Set this release" %></span>
            <%= icon_tag "check", class: "checked flex-item-no-shrink flex-item-justify-end", style: "--icon-size: 1em" %>
          <% end %>
        <% end %>
      <% end %>

      <li class="popup__item" data-navigable-list-target="item">
        <%= button_tag type: "submit", form: dom_id(@card, :release_form), class: "btn popup__btn", data: { form_target: "submit" } do %>
          <%= icon_tag "add" %>
          <span>Add release</span>
        <% end %>
      </li>
    </ul>

    <% if @releases.size > Card::Releasable::SHOWN_BY_DEFAULT %>
      <div class="popup__footer txt-x-small">Search to find older releases</div>
    <% end %>
  </div>
<% end %>
